{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakup",
      "AskUserQuestion",
      "CronDelete",
      "CronList",
      "CronCreate",
      "TaskOutput"
    ]
  },
  "model": "claude-fable-5[1m]",
  "disableClaudeAiConnectors": true,
  "disableBundledSkills": true,
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'tell application \"System Events\" to set frontApp to name of first application process whose frontmost is true' -e 'if frontApp is not in {\"Terminal\", \"iTerm2\", \"kitty\", \"Alacritty\", \"Ghostty\", \"wezterm-gui\", \"WezTerm\", \"Hyper\", \"Warp\", \"Rio\", \"Claude\"} then' -e 'display notification \"Claude Code response complete\" with title \"Claude Code\"' -e 'end if'"
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:one-dark",
  "editorMode": "normal",
  "voiceEnabled": true,
  "shiftEnterKeyBindingInstalled": true
}
