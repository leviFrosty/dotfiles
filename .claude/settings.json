{
  "includeCoAuthoredBy": false,
  "model": "claude-fable-5[1m]",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'tell application \"System Events\" to set frontApp to name of first application process whose frontmost is true' -e 'if frontApp is not in {\"Terminal\", \"iTerm2\", \"kitty\", \"Alacritty\", \"Ghostty\", \"wezterm-gui\", \"WezTerm\", \"Hyper\", \"Warp\", \"Rio\", \"Claude\"} then' -e 'display notification \"Claude Code response complete\" with title \"Claude Code\"' -e 'end if'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false,
    "swift-lsp@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "custom:one-dark",
  "editorMode": "normal",
  "voiceEnabled": true,
  "shiftEnterKeyBindingInstalled": true
}
